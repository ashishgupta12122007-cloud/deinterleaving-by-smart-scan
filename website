function drawHeroRadar(){
  const box = document.getElementById('heroRadar');
  if(!box) return;
  const size = 420;
  const svg = svgEl('svg', { viewBox:`0 0 ${size} ${size}`, width:'100%', height:'100%' });
  const c = size/2;
  [1,2,3,4].forEach(i=>{
    svg.appendChild(svgEl('circle', { cx:c, cy:c, r:(size/2-10)*(i/4), fill:'none', stroke:'rgba(166,225,250,0.16)', 'stroke-width':1 }));
  });
  for(let a=0;a<360;a+=30){
    const rad = a*Math.PI/180;
    svg.appendChild(svgEl('line', { x1:c, y1:c, x2:c+Math.cos(rad)*(size/2-10), y2:c+Math.sin(rad)*(size/2-10), stroke:'rgba(166,225,250,0.08)', 'stroke-width':1 }));
  }
  const colors = ['#A6E1FA','#F2B84B','#59D6A6'];
  const radii = [0.35,0.55,0.78];
  colors.forEach((col,i)=>{
    const ang = i*120+18;
    const rad = ang*Math.PI/180;
    const r = (size/2-10)*radii[i];
    const cx = c+Math.cos(rad)*r, cy = c+Math.sin(rad)*r;
    const dot = svgEl('circle', { cx, cy, r:5, fill:col });
    dot.style.filter = 'drop-shadow(0 0 6px ' + col + ')';
    svg.appendChild(dot);
  });
  const sweep = svgEl('g', {});
  sweep.appendChild(svgEl('line', { x1:c, y1:c, x2:c, y2:10, stroke:'#A6E1FA', 'stroke-width':1.4 }));
  const wedge = svgEl('path', { d:`M ${c} ${c} L ${c} 10 A ${c-10} ${c-10} 0 0 1 ${c+ (c-10)*Math.sin(0.6)} ${c-(c-10)*Math.cos(0.6)} Z`, fill:'rgba(166,225,250,0.14)' });
  sweep.appendChild(wedge);
  const anim = svgEl('animateTransform', { attributeName:'transform', type:'rotate', from:`0 ${c} ${c}`, to:`360 ${c} ${c}`, dur:'6s', repeatCount:'indefinite' });
  sweep.appendChild(anim);
  svg.appendChild(sweep);
  box.innerHTML = '';
  box.appendChild(svg);
}

