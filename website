      + '<div class="stat"><span>RF '+rfSpan+'</span><span>PRI '+priModeLabel+', ~'+em.basePRI.toFixed(1)+' μs</span><span>AOA '+em.aoaCenter.toFixed(0)+'°</span><span>PULSES '+pts.length+'</span></div>'
      + '</div>';
