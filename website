  if(isPanelActive('emitters')) drawEmittersView();
}

/* ============================================================
   HUD / PIPELINE / TELEMETRY
   ============================================================ */
function updateHud(){
  const t = sim.progress;
  const bounds = { acq:0.15, pdw:0.30, ana:0.70, out:1.0 };
  document.querySelectorAll('.hud-stage').forEach(el=>{
    const key = el.dataset.hud;
    el.classList.remove('live','done');
    if(!sim.generated) return;
    const b = bounds[key];
    const prevB = key==='acq'?0 : key==='pdw'?bounds.acq : key==='ana'?bounds.pdw : bounds.ana;
    if(t>=b) el.classList.add('done'); else if(t>prevB) el.classList.add('live');
  });
}
function updateProcSteps(){
  const bounds = [0.15,0.30,0.55,0.70,0.85,1.0];
  document.querySelectorAll('.proc-step').forEach((s,i)=>{
    s.classList.remove('active','done');
    const mark = s.querySelector('.proc-mark');
    if(!sim.generated){ mark.textContent='○'; return; }
    const lower = i===0?0:bounds[i-1], upper = bounds[i];
    if(sim.progress>=upper){ s.classList.add('done'); mark.textContent='✓'; }
    else if(sim.progress>lower){ s.classList.add('active'); mark.textContent='●'; }
    else mark.textContent='○';
  });
}
function updateTelemetry(){
  const n = sim.generated ? sim.pulses.length : 0;
  const set = (id,val)=>{ const el=document.getElementById(id); if(el) el.textContent=val; };
  set('telPulses', sim.generated ? n : '—');
  set('telPdw', sim.generated ? Math.round(sim.progress*n) : '—');
  set('telEmit', sim.generated ? sim.emitters.length : '—');
  set('telWindow', sim.generated ? sim.cfg.timeWindow+' μs' : '—');
  const ref = sim.pulses.find(p=>p.id===sim.selectedId) || (sim.generated ? sim.pulses[sim.pulses.length-1] : null);
  set('telRf', ref ? ref.rf.toFixed(2)+' GHz' : '—');
  set('telPri', ref ? ref.pri.toFixed(2)+' μs' : '—');
  set('mTotal', sim.generated ? n : '—');
  set('mEmit', sim.generated ? sim.emitters.length : '—');
  set('mProc', sim.generated ? Math.round(sim.progress*n) : '0');
  set('mStatus', !sim.generated ? 'IDLE' : sim.running ? 'RUNNING' : (sim.progress>=0.98 ? 'COMPLETE' : 'READY'));
  set('mNoise', sim.generated ? sim.cfg.noiseLevel.toUpperCase() : '—');
  set('mSel', sim.selectedId || '—');
  set('outputTag', sim.progress>=0.98 ? 'DEMO OUTPUT' : 'AWAITING RUN');
}
function updateEmitterLegend(){
  const el = document.getElementById('emitterLegend'); if(!el) return;
  if(!sim.generated || sim.progress<0.98){ el.innerHTML=''; return; }
  el.innerHTML = sim.emitters.map((em,i)=>'<div class="legend-item" data-idx="'+i+'"><span class="legend-swatch" style="background:'+em.color+';"></span>EMITTER 0'+(i+1)+'</div>').join('');
}

