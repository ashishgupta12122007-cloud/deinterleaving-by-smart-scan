/* ============================================================
   DATA MODEL — separate from rendering
   ============================================================ */
function rngFactory(seed){
  let s = seed % 2147483647; if(s<=0) s += 2147483646;
  return function(){ s = (s*16807) % 2147483647; return (s-1)/2147483646; };
}
function buildHopSet(nominal,n,rnd){
  const set=[];
  for(let i=0;i<n;i++) set.push(+(nominal + (rnd()-0.5)*0.9 + i*0.11).toFixed(3));
  return set;
}
function generateSignalModel(cfg){
  const rnd = rngFactory(Date.now()%100000 + 7);
  const emitters=[];
  for(let e=0;e<cfg.emitterCount;e++){
    const nominalRF = +(9.1 + e*0.42 + rnd()*0.12).toFixed(3);
    const agile = cfg.freqMode === 'agile';
    const freqSet = agile ? buildHopSet(nominalRF, 4+(e%2), rnd) : [nominalRF];
    const basePRI = +(10 + e*4.2 + rnd()*3).toFixed(2);
    const pw = +(0.7 + rnd()*2.1).toFixed(2);
    const aoaCenter = +(rnd()*360).toFixed(1);
    emitters.push({ id:e, color:EMITTER_COLORS[e%EMITTER_COLORS.length], nominalRF, freqSet, basePRI, pw, aoaCenter, agile, priMode:cfg.priMode });
  }
  let pulses=[], pid=0;
  emitters.forEach(em=>{
    let t = rnd()*em.basePRI;
    let hop = Math.floor(rnd()*em.freqSet.length);
    while(t < cfg.timeWindow){
      let pri = em.basePRI;
      if(em.priMode==='stagger'){ pri = em.basePRI * (0.55 + (hop%3)*0.45); }
      else if(em.priMode==='jitter'){ pri = em.basePRI * (0.8 + rnd()*0.4); }
      const rf = em.agile ? em.freqSet[hop % em.freqSet.length] : em.nominalRF;
      pulses.push({
        id:'P'+String(pid).padStart(4,'0'), emitterId:em.id,
        toa:+t.toFixed(3), pri:+pri.toFixed(2), rf:rf,
        pw:+(em.pw + (rnd()-0.5)*0.25).toFixed(2), aoa:+(em.aoaCenter + (rnd()-0.5)*7).toFixed(1),
        amplitude:+(0.45+rnd()*0.55).toFixed(2), noise:false,
      });
      pid++; hop++; t += pri;
    }
  });
  const noiseCount = { low:2, medium:7, high:18 }[cfg.noiseLevel] || 0;
  for(let i=0;i<noiseCount;i++){
    pulses.push({
      id:'N'+String(i).padStart(3,'0'), emitterId:-1,
      toa:+(rnd()*cfg.timeWindow).toFixed(3), pri:+(4+rnd()*20).toFixed(2),
      rf:+(9+rnd()*2.2).toFixed(3), pw:+(0.3+rnd()*1.5).toFixed(2),
      aoa:+(rnd()*360).toFixed(1), amplitude:+(0.15+rnd()*0.3).toFixed(2), noise:true,
    });
  }
  pulses.sort((a,b)=>a.toa-b.toa);
  pulses.forEach((p,i)=>p.index=i);
  return { emitters, pulses };
}

/* ============================================================
   CANVAS HELPERS
   ============================================================ */
function fitCanvas(canvas){
  const rect = canvas.parentElement.getBoundingClientRect();
  const ratio = window.devicePixelRatio || 1;
  const w = Math.max(1, Math.floor(rect.width)), h = Math.max(1, Math.floor(rect.height));
  if(canvas._cw!==w || canvas._ch!==h || canvas._ratio!==ratio){
    canvas.width = w*ratio; canvas.height = h*ratio;
    canvas.style.width = w+'px'; canvas.style.height = h+'px';
    canvas._cw=w; canvas._ch=h; canvas._ratio=ratio;
  }
  const ctx = canvas.getContext('2d');
  ctx.setTransform(ratio,0,0,ratio,0,0);
  return { ctx, w, h };
}
function drawGridLines(ctx,w,h,vLines,hLines){
  ctx.save(); ctx.strokeStyle='rgba(166,225,250,0.07)'; ctx.lineWidth=1;
  for(let i=0;i<=vLines;i++){ const x=Math.round((w/vLines)*i)+0.5; ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,h); ctx.stroke(); }
  for(let i=0;i<=hLines;i++){ const y=Math.round((h/hLines)*i)+0.5; ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); }
  ctx.restore();
}
function axisText(ctx,text,x,y,align,color){
  ctx.save(); ctx.font='9.5px "IBM Plex Mono", monospace'; ctx.fillStyle=color||'rgba(147,169,204,0.85)';
  ctx.textAlign=align||'left'; ctx.textBaseline='middle'; ctx.fillText(text,x,y); ctx.restore();
}
function emptyState(ctx,w,h,msg){
  ctx.save(); ctx.font='11px "IBM Plex Mono", monospace'; ctx.fillStyle='rgba(93,112,150,0.9)';
  ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(msg, w/2, h/2); ctx.restore();
}
function drawCallout(ctx,x,y,lines,plotW){
  ctx.save(); ctx.font='10px "IBM Plex Mono", monospace';
  const width=132, lh=14, height=10+lines.length*lh;
  let bx = x+10; if(bx+width>plotW) bx = x-10-width;
  ctx.fillStyle='rgba(0,10,50,0.92)'; ctx.strokeStyle='rgba(166,225,250,0.35)'; ctx.lineWidth=1;
  ctx.fillRect(bx,y,width,height); ctx.strokeRect(bx,y,width,height);
  lines.forEach((l,i)=>{
    ctx.fillStyle = i===0 ? '#A6E1FA' : '#EEF3FA'; ctx.textAlign='left'; ctx.textBaseline='top';
    ctx.fillText(l, bx+8, y+8+i*lh);
  });
  ctx.restore();
}
function emitterColor(p){ return p.noise ? 'rgba(166,225,250,0.28)' : EMITTER_COLORS[p.emitterId % EMITTER_COLORS.length]; }
function hexToRgb(hex){ const v=parseInt(hex.slice(1),16); return { r:(v>>16)&255, g:(v>>8)&255, b:v&255 }; }
function parseRgba(str){ const m=str.match(/[\d.]+/g).map(Number); return { r:m[0], g:m[1], b:m[2] }; }
function mixLerpColor(c1,c2,t){
  const a=parseRgba(c1), b=hexToRgb(c2);
  return `rgb(${Math.round(lerp(a.r,b.r,t))},${Math.round(lerp(a.g,b.g,t))},${Math.round(lerp(a.b,b.b,t))})`;
}
function computeDomain(key){
  const vals = sim.pulses.map(p=>p[key]);
  let min=Math.min(...vals), max=Math.max(...vals);
  if(min===max){ min-=1; max+=1; }
  const pad=(max-min)*0.08;
  return [min-pad, max+pad];
}
function isPanelActive(tabKey){
  const panel = document.querySelector('.viz-panel[data-panel="'+tabKey+'"]');
  return !!(panel && panel.classList.contains('active'));
}

/* ============================================================
   TIME DOMAIN VIEW
   ============================================================ */
function drawTimeDomain(){
  const canvas = document.getElementById('cvTime'); if(!canvas) return;
  const { ctx,w,h } = fitCanvas(canvas);
  ctx.clearRect(0,0,w,h);
  if(!sim.generated){ emptyState(ctx,w,h,'GENERATE A SIGNAL TO BEGIN'); sim.hitTargets.time=[]; return; }
  const pad={ l:8, r:8, t:16, b:26 };
  const plotW=w-pad.l-pad.r, plotH=h-pad.t-pad.b;
  const tv = sim.view.time, tMax = sim.cfg.timeWindow;
  drawGridLines(ctx,plotW,plotH,10,4);
  ctx.save(); ctx.translate(pad.l,pad.t);
  function xFor(toa){ return ((toa/tMax)*plotW)*tv.scale - tv.offset; }
  ctx.strokeStyle='rgba(166,225,250,0.25)'; ctx.beginPath(); ctx.moveTo(0,plotH-14); ctx.lineTo(plotW,plotH-14); ctx.stroke();

  const colored = sim.progress >= 0.98;
  const targets=[];
  sim.pulses.forEach(p=>{
    const x = xFor(p.toa);
    if(x<-12 || x>plotW+12) return;
    const baseY = plotH-14, amp = 18 + p.amplitude*46;
    const isSelected = sim.selectedId===p.id, isHover = sim.hoverId===p.id;
    const col = colored ? emitterColor(p) : (p.noise ? 'rgba(166,225,250,0.22)' : 'rgba(166,225,250,0.85)');
    ctx.strokeStyle=col; ctx.lineWidth=isSelected?2.4:1.4; ctx.globalAlpha=isSelected||isHover?1:0.82;
    ctx.beginPath(); ctx.moveTo(x,baseY); ctx.lineTo(x,baseY-amp); ctx.stroke();
    ctx.beginPath(); ctx.arc(x,baseY-amp, isSelected?4:2.4, 0, Math.PI*2); ctx.fillStyle=col; ctx.fill();
    if(isSelected||isHover){ ctx.globalAlpha=0.18; ctx.beginPath(); ctx.arc(x,baseY-amp,10,0,Math.PI*2); ctx.fillStyle=col; ctx.fill(); }
    ctx.globalAlpha=1;
    targets.push({ id:p.id, x:x+pad.l, y:baseY-amp+pad.t, r:9 });
  });

  const sel = sim.pulses.find(p=>p.id===sim.selectedId);
  if(sel){
    const x = xFor(sel.toa);
    ctx.strokeStyle='rgba(166,225,250,0.35)'; ctx.setLineDash([3,3]);
    ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,plotH); ctx.stroke(); ctx.setLineDash([]);
    drawCallout(ctx,x,10,[ 'PULSE '+sel.id, 'TOA  '+sel.toa.toFixed(2)+' μs', 'RF   '+sel.rf.toFixed(2)+' GHz', 'PW   '+sel.pw.toFixed(2)+' μs', 'PRI  '+sel.pri.toFixed(2)+' μs' ], plotW);
  }
  ctx.restore();
  axisText(ctx,'0 μs', pad.l+4, h-10, 'left');
  axisText(ctx, tMax.toFixed(0)+' μs', w-pad.r-4, h-10, 'right');
  sim.hitTargets.time = targets;
}

/* ============================================================
   FEATURE SPACE VIEW
   ============================================================ */
function drawFeatureSpace(){
  const canvas = document.getElementById('cvFeature'); if(!canvas) return;
  const { ctx,w,h } = fitCanvas(canvas);
  ctx.clearRect(0,0,w,h);
  if(!sim.generated){ emptyState(ctx,w,h,'GENERATE A SIGNAL TO BEGIN'); sim.hitTargets.feature=[]; return; }
  const pad={ l:44, r:16, t:16, b:30 };
  const plotW=w-pad.l-pad.r, plotH=h-pad.t-pad.b;
  const xk=sim.featX, yk=sim.featY;
  const dx=computeDomain(xk), dy=computeDomain(yk);
  const fv = sim.view.feature;
  ctx.save(); ctx.translate(pad.l,pad.t);
  drawGridLines(ctx,plotW,plotH,8,6);
  function X(v){ return ((v-dx[0])/(dx[1]-dx[0]))*plotW*fv.scale + fv.panX; }
  function Y(v){ return plotH - ((v-dy[0])/(dy[1]-dy[0]))*plotH*fv.scale + fv.panY; }

  const relAlpha = sim.running ? clamp((sim.progress-0.55)/0.15,0,1) * (1-clamp((sim.progress-0.70)/0.15,0,1)) : 0;
  if(relAlpha>0.02){
    ctx.globalAlpha = relAlpha*0.55;
    sim.emitters.forEach((em,e)=>{
      const pts = sim.pulses.filter(p=>p.emitterId===e);
      ctx.strokeStyle = em.color; ctx.lineWidth=0.8;
      for(let i=1;i<pts.length;i++){ ctx.beginPath(); ctx.moveTo(X(pts[i-1][xk]),Y(pts[i-1][yk])); ctx.lineTo(X(pts[i][xk]),Y(pts[i][yk])); ctx.stroke(); }
    });
    ctx.globalAlpha=1;
  }

  const colorProgress = sim.running ? clamp((sim.progress-0.3)/0.35,0,1) : (sim.progress>=0.98?1:0);
  const targets=[];
  sim.pulses.forEach(p=>{
    const x=X(p[xk]), y=Y(p[yk]);
    if(x<-12||x>plotW+12||y<-12||y>plotH+12) return;
    const mixedCol='rgba(166,225,250,0.55)';
    const col = colorProgress<=0.01 ? mixedCol : mixLerpColor(mixedCol, emitterColor(p), colorProgress);
    const isSelected=sim.selectedId===p.id, isHover=sim.hoverId===p.id;
    ctx.globalAlpha = isSelected||isHover?1:0.78;
    ctx.beginPath(); ctx.arc(x,y, isSelected?5:(p.noise?2:3), 0, Math.PI*2); ctx.fillStyle=col; ctx.fill();
    if(isSelected){ ctx.globalAlpha=0.25; ctx.beginPath(); ctx.arc(x,y,10,0,Math.PI*2); ctx.fillStyle=col; ctx.fill(); }
    ctx.globalAlpha=1;
    targets.push({ id:p.id, x:x+pad.l, y:y+pad.t, r:8 });
  });
  ctx.restore();
  axisText(ctx, xk.toUpperCase()+(xk==='rf'?' (GHz)':xk==='pri'||xk==='toa'||xk==='pw'?' (μs)':' (°)'), w-pad.r, h-10, 'right', '#93A9CC');
  ctx.save(); ctx.translate(12,pad.t); ctx.rotate(-Math.PI/2); axisText(ctx, yk.toUpperCase(), 0,0,'left','#93A9CC'); ctx.restore();
  sim.hitTargets.feature = targets;
}

/* ============================================================
   FREQUENCY-HOP TRAJECTORY VIEW
   ============================================================ */
function strokeStepLine(ctx,pts,color){
  ctx.strokeStyle=color; ctx.lineWidth=1.6; ctx.beginPath();
  pts.forEach((pt,i)=>{ if(i===0){ ctx.moveTo(pt.x,pt.y); } else { ctx.lineTo(pt.x,pts[i-1].y); ctx.lineTo(pt.x,pt.y); } });
  ctx.stroke();
}
function drawFreqView(){
  const canvas = document.getElementById('cvFreq'); if(!canvas) return;
  const { ctx,w,h } = fitCanvas(canvas);
  ctx.clearRect(0,0,w,h);
  if(!sim.generated){ emptyState(ctx,w,h,'GENERATE A SIGNAL TO BEGIN'); sim.hitTargets.freq=[]; return; }
  const pad={ l:50, r:16, t:16, b:26 };
  const plotW=w-pad.l-pad.r, plotH=h-pad.t-pad.b;
  const rfAll = sim.pulses.map(p=>p.rf);
  const rMin=Math.min(...rfAll), rMax=Math.max(...rfAll), rPad=(rMax-rMin)*0.15||0.1;
  ctx.save(); ctx.translate(pad.l,pad.t);
  drawGridLines(ctx,plotW,plotH,8,4);
  function Y(v){ return plotH - ((v-(rMin-rPad))/((rMax+rPad)-(rMin-rPad)))*plotH; }
  const reveal = sim.running ? clamp(sim.progress/0.4,0,1) : 1;
  const targets=[];
  sim.emitters.forEach((em,ei)=>{
    const pts = sim.pulses.filter(p=>p.emitterId===ei);
    const n = Math.max(1, Math.round(pts.length*reveal));
    const shown = pts.slice(0,n);
    const coords = shown.map((p,i)=>({ x:(i/((pts.length-1)||1))*plotW, y:Y(p.rf) }));
    ctx.globalAlpha=0.9; strokeStepLine(ctx,coords,em.color); ctx.globalAlpha=1;
    coords.forEach((c,i)=>{
      const p = shown[i]; const isSel = sim.selectedId===p.id;
      ctx.beginPath(); ctx.arc(c.x,c.y, isSel?4:2, 0, Math.PI*2); ctx.fillStyle=isSel?'#fff':em.color; ctx.fill();
      targets.push({ id:p.id, x:c.x+pad.l, y:c.y+pad.t, r:8 });
    });
  });
  ctx.restore();
  axisText(ctx, rMin.toFixed(2)+' GHz', 6, h-pad.b, 'left');
  axisText(ctx, rMax.toFixed(2)+' GHz', 6, pad.t+6, 'left');
  sim.hitTargets.freq = targets;

  const em0 = sim.pulses.filter(p=>p.emitterId===0);
  const ref = sim.pulses.find(p=>p.id===sim.selectedId) || em0[em0.length-1];
  if(ref){
    const sameE = sim.pulses.filter(p=>p.emitterId===ref.emitterId);
    const pos = sameE.findIndex(p=>p.id===ref.id);
    const prev = pos>0 ? sameE[pos-1] : null;
    document.getElementById('agCurrent').textContent = ref.rf.toFixed(2)+' GHz';
    document.getElementById('agPrev').textContent = prev ? prev.rf.toFixed(2)+' GHz' : '—';
    document.getElementById('agHop').textContent = prev ? (((ref.rf-prev.rf)>=0?'+':'')+((ref.rf-prev.rf)*1000).toFixed(0)+' MHz') : '—';
  }
}

