}
function redrawAll(){
  updateHud(); updateProcSteps(); updateTelemetry(); updateEmitterLegend();
  if(isPanelActive('overview')) drawOverview();
  if(isPanelActive('time')) drawTimeDomain();
  if(isPanelActive('feature')) drawFeatureSpace();
  if(isPanelActive('freq')) drawFreqView();
