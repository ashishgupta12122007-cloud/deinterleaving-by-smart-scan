/* ============================================================
   WATERFALL / SIGNAL-DENSITY VIEW
   ============================================================ */
function initWaterfall(){ sim.waterfall.rows=[]; sim.waterfall.tAccum=0; }
function stepWaterfall(dt){
  if(!sim.generated || !sim.waterfall.live || prefersReducedMotion()) return;
  sim.waterfall.tAccum += dt;
  const rowInterval = 90;
  while(sim.waterfall.tAccum > rowInterval){
    sim.waterfall.tAccum -= rowInterval;
    const bins=64; const row=new Float32Array(bins);
    const rfAll = sim.pulses.map(p=>p.rf), rMin=Math.min(...rfAll), rMax=Math.max(...rfAll);
    const tCenter = (Date.now()/38) % sim.cfg.timeWindow;
    sim.pulses.forEach(p=>{
      const d = Math.abs(p.toa - tCenter);
      if(d < sim.cfg.timeWindow*0.03){
        const bin = clamp(Math.floor(((p.rf-rMin)/((rMax-rMin)||1))*bins),0,bins-1);
        row[bin] = Math.min(1, row[bin]+p.amplitude);
      }
    });
    sim.waterfall.rows.unshift(row);
    if(sim.waterfall.rows.length>140) sim.waterfall.rows.pop();
  }
}
function drawWaterfall(){
  const canvas = document.getElementById('cvWaterfall'); if(!canvas) return;
  const { ctx,w,h } = fitCanvas(canvas);
  ctx.clearRect(0,0,w,h);
  if(!sim.generated){ emptyState(ctx,w,h,'GENERATE A SIGNAL TO BEGIN'); return; }
  const rows = sim.waterfall.rows;
  const rowH = Math.max(2, h/140);
  const bins = rows[0] ? rows[0].length : 64;
  const colW = w/bins;
  rows.forEach((row,ri)=>{
    const y = ri*rowH; if(y>h) return;
    for(let b=0;b<bins;b++){
      const v = row[b]; if(v<=0.02) continue;
      const alpha = Math.min(0.9,v) * (1-ri/rows.length*0.4);
      ctx.fillStyle = 'rgba(166,225,250,'+alpha.toFixed(3)+')';
      ctx.fillRect(b*colW, y, colW+0.5, rowH+0.5);
    }
  });
  ctx.strokeStyle='rgba(166,225,250,0.06)';
  for(let i=1;i<8;i++){ const x=(w/8)*i; ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,h); ctx.stroke(); }
}

/* ============================================================
   OVERVIEW — cinematic phase-driven transformation canvas
   ============================================================ */
function drawOverview(){
  const canvas = document.getElementById('cvOverview'); if(!canvas) return;
  const { ctx,w,h } = fitCanvas(canvas);
  ctx.clearRect(0,0,w,h);
  const lbl = document.getElementById('overviewPhaseLabel');
  if(!sim.generated){ emptyState(ctx,w,h,'PRESS GENERATE SIGNAL TO BEGIN'); sim.hitTargets.overview=[]; if(lbl) lbl.textContent='IDLE'; return; }

  const t = sim.progress;
  const pad={ l:16, r:16, t:16, b:16 };
  const plotW=w-pad.l-pad.r, plotH=h-pad.t-pad.b;
  drawGridLines(ctx,plotW,plotH,10,6);
  ctx.save(); ctx.translate(pad.l,pad.t);

  const seg = { acq:[0,0.15], pdw:[0.15,0.30], feat:[0.30,0.55], rel:[0.55,0.70], clus:[0.70,0.85], recon:[0.85,1.0] };
  function segT(name){ const b=seg[name]; return clamp((t-b[0])/(b[1]-b[0]),0,1); }

  const tMax = sim.cfg.timeWindow;
  const rfAll = sim.pulses.map(p=>p.rf), rMin=Math.min(...rfAll), rMax=Math.max(...rfAll);
  const priAll = sim.pulses.map(p=>p.pri), prMin=Math.min(...priAll), prMax=Math.max(...priAll);

  function posA(p){ return { x:(p.toa/tMax)*plotW, y: plotH-20 - (p.index%7)*((plotH-60)/7) }; }
  function posB(p){ return { x:((p.rf-rMin)/((rMax-rMin)||1))*plotW*0.9+plotW*0.05, y: plotH - (((p.pri-prMin)/((prMax-prMin)||1))*plotH*0.75+plotH*0.1) }; }
  function posC(p){ const laneH=plotH/sim.emitters.length; return { x:(p.toa/tMax)*plotW, y: p.emitterId>=0 ? p.emitterId*laneH+laneH*0.6 : plotH-6 }; }

  let blend='A', label='ACQUISITION', acqReveal=1, relAlpha=0, clusterSplit=0;
  if(t <= seg.acq[1]){ blend='A'; label='ACQUISITION'; acqReveal=segT('acq'); }
  else if(t <= seg.pdw[1]){ blend='A'; label='PDW EXTRACTION'; acqReveal=1; }
  else if(t <= seg.feat[1]){ blend='AB'; label='FEATURE SPACE'; acqReveal=1; }
  else if(t <= seg.rel[1]){ blend='B'; label='RELATIONSHIP ANALYSIS'; acqReveal=1; relAlpha=Math.sin(segT('rel')*Math.PI); }
  else if(t <= seg.clus[1]){ blend='B'; label='DEINTERLEAVING'; acqReveal=1; clusterSplit=segT('clus'); }
  else { blend='BC'; label='EMITTER STREAMS'; acqReveal=1; clusterSplit=1; }

  if(label==='ACQUISITION'){
    const beamX = acqReveal*plotW;
    ctx.strokeStyle='rgba(166,225,250,0.55)'; ctx.lineWidth=1.4;
    ctx.beginPath(); ctx.moveTo(beamX,0); ctx.lineTo(beamX,plotH); ctx.stroke();
    ctx.fillStyle='rgba(166,225,250,0.08)'; ctx.fillRect(Math.max(0,beamX-40),0,40,plotH);
  }

  const clusterCenters = sim.emitters.map((em,ei)=>{
    const ang = (ei/sim.emitters.length)*Math.PI*2 - Math.PI/2;
    return { x: plotW/2 + Math.cos(ang)*plotW*0.32, y: plotH/2 + Math.sin(ang)*plotH*0.32 };
  });

  const targets=[];
  sim.pulses.forEach(p=>{
    const a=posA(p), b=posB(p), c=posC(p);
    let x,y,alpha=1,col;
    if(blend==='A'){
      x=a.x; y=a.y;
      alpha = label==='ACQUISITION' ? (a.x <= acqReveal*plotW ? 1 : 0.08) : 1;
      col = 'rgba(166,225,250,0.8)';
    } else if(blend==='AB'){
      const bt = easeInOutCubic(segT('feat'));
      x=lerp(a.x,b.x,bt); y=lerp(a.y,b.y,bt);
      col='rgba(166,225,250,0.75)';
    } else if(blend==='B'){
      let bx=b.x, by=b.y;
      if(clusterSplit>0){
        const cc = clusterCenters[p.emitterId>=0?p.emitterId:0];
        const cs = easeInOutCubic(clusterSplit);
        bx = lerp(b.x, lerp(b.x,cc.x,0.6), cs); by = lerp(b.y, lerp(b.y,cc.y,0.6), cs);
      }
      x=bx; y=by;
      col = clusterSplit>0.05 ? mixLerpColor('rgba(166,225,250,0.75)', emitterColor(p), clusterSplit) : 'rgba(166,225,250,0.75)';
    } else {
      const cc = clusterCenters[p.emitterId>=0?p.emitterId:0];
      const bClustered = { x:lerp(b.x,cc.x,0.6), y:lerp(b.y,cc.y,0.6) };
      const rt = easeInOutCubic(segT('recon'));
      x=lerp(bClustered.x,c.x,rt); y=lerp(bClustered.y,c.y,rt);
      col = emitterColor(p);
    }
    const isSel = sim.selectedId===p.id;
    ctx.globalAlpha = alpha*(isSel?1:0.85);
    ctx.beginPath(); ctx.arc(x,y, isSel?4.5:2.6, 0, Math.PI*2); ctx.fillStyle=col; ctx.fill();
    ctx.globalAlpha=1;
    targets.push({ id:p.id, x:x+pad.l, y:y+pad.t, r:8 });
  });

  if(relAlpha>0.02){
    ctx.globalAlpha = relAlpha*0.5;
    sim.emitters.forEach((em,ei)=>{
      const pts = sim.pulses.filter(p=>p.emitterId===ei).map(posB);
      ctx.strokeStyle=em.color; ctx.lineWidth=0.8;
      for(let i=1;i<pts.length;i++){ ctx.beginPath(); ctx.moveTo(pts[i-1].x,pts[i-1].y); ctx.lineTo(pts[i].x,pts[i].y); ctx.stroke(); }
    });
    ctx.globalAlpha=1;
  }
  if(clusterSplit>0.3 && blend!=='BC'){
    sim.emitters.forEach((em,ei)=>{
      const cc = clusterCenters[ei];
      ctx.font='10px "IBM Plex Mono", monospace'; ctx.fillStyle=em.color; ctx.textAlign='center';
      ctx.globalAlpha = clamp((clusterSplit-0.3)/0.4,0,1);
      ctx.fillText('EMITTER 0'+(ei+1), cc.x, cc.y-14);
      ctx.globalAlpha=1;
    });
  }
  if(blend==='BC'){
    const laneH = plotH/sim.emitters.length;
    sim.emitters.forEach((em,ei)=>{
      ctx.font='10px "IBM Plex Mono", monospace'; ctx.fillStyle=em.color; ctx.textAlign='left';
      ctx.fillText('EMITTER 0'+(ei+1), 4, ei*laneH+laneH*0.6-14);
    });
  }
  ctx.restore();
  sim.hitTargets.overview = targets;
  if(lbl) lbl.textContent = label;
  const tag = document.getElementById('overviewTag');
  if(tag) tag.textContent = t>=0.98 ? 'DEMO OUTPUT — SEPARATED' : (sim.running ? 'PROCESSING · '+label : 'MIXED SIGNAL');
}

