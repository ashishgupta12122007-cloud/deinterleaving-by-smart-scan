}

/* ============================================================
   CONTROLS / RUN LOOP
   ============================================================ */
function readConfigFromUI(){
  sim.cfg.emitterCount = parseInt(document.getElementById('emCount').textContent,10) || 3;
  sim.cfg.freqMode = document.getElementById('simMode').value;
  sim.cfg.priMode = document.getElementById('simPri').value;
  sim.cfg.noiseLevel = document.getElementById('simNoise').value;
  sim.cfg.timeWindow = parseInt(document.getElementById('simWindow').value,10);
  sim.cfg.speed = parseInt(document.getElementById('simSpeed').value,10);
}
function generateStream(){
  readConfigFromUI();
  const model = generateSignalModel(sim.cfg);
  sim.emitters = model.emitters; sim.pulses = model.pulses;
  sim.generated = true; sim.running = false; sim.paused = false; sim.progress = 0;
  sim.selectedId = null; sim.hoverId = null;
  sim.view.time = { scale:1, offset:0 };
  sim.view.feature = { scale:1, offset:0, panX:0, panY:0 };
  const scrub = document.getElementById('scrubSlider'); if(scrub) scrub.value = 0;
  const pauseBtn = document.getElementById('btnPause'); if(pauseBtn) pauseBtn.textContent = 'PAUSE';
  initWaterfall();
  const insp = document.getElementById('pulseInspector'); if(insp) insp.classList.remove('show');
  document.getElementById('pdwBody').innerHTML = '<tr><td colspan="2" style="color:var(--text-faint);">Select a pulse in any chart, or an emitter above, to inspect its PDW.</td></tr>';
  redrawAll();
}
function runDeinterleave(){
  if(!sim.generated || sim.running) return;
  sim.running = true; sim.paused = false;
  if(sim.progress>=1) sim.progress = 0;
  if(prefersReducedMotion()){ sim.progress = 1; onRunComplete(); }
}
function onRunComplete(){
  sim.running = false; sim.progress = 1;
  const scrub = document.getElementById('scrubSlider'); if(scrub) scrub.value = 1000;
  redrawAll();
}
function pauseToggle(){
  if(!sim.running) return;
  sim.paused = !sim.paused;
  const btn = document.getElementById('btnPause'); if(btn) btn.textContent = sim.paused ? 'RESUME' : 'PAUSE';
}
function resetSimulation(){ generateStream(); }
function replayDemo(){
  if(!sim.generated) generateStream();
  switchTab('overview');
  sim.progress = 0; sim.running = true; sim.paused = false;
  const scrub = document.getElementById('scrubSlider'); if(scrub) scrub.value = 0;
}
function toggleJudgeMode(){
  sim.judgeMode = !sim.judgeMode;
  const shell = document.getElementById('simShell'); if(shell) shell.classList.toggle('judge-mode', sim.judgeMode);
  const btn = document.getElementById('btnJudge'); if(btn) btn.textContent = sim.judgeMode ? 'EXIT JUDGE MODE' : 'JUDGE DEMO';
  if(sim.judgeMode) runGuidedSequence();
}
function runGuidedSequence(){
  if(!sim.generated) generateStream();
  const tabs = ['overview','time','freq','feature','emitters'];
  let i = 0;
  switchTab('overview'); sim.progress=0; sim.running=true; sim.paused=false;
  function next(){
    if(!sim.judgeMode) return;
    i++;
    if(i<tabs.length){ switchTab(tabs[i]); setTimeout(next, 6000); }
  }
  setTimeout(next, 9000);
}

/* ============================================================
   ANIMATION LOOP — requestAnimationFrame, no setInterval
   ============================================================ */
function animFrame(ts){
  if(!sim.lastFrameTime) sim.lastFrameTime = ts;
  const dt = ts - sim.lastFrameTime;
  sim.lastFrameTime = ts;
  if(sim.running && !sim.paused){
    const speedFactor = { 1:0.00006, 2:0.00012, 3:0.00022 }[sim.cfg.speed] || 0.00012;
    sim.progress = clamp(sim.progress + dt*speedFactor, 0, 1);
    const scrub = document.getElementById('scrubSlider'); if(scrub) scrub.value = Math.round(sim.progress*1000);
    if(sim.progress>=1) onRunComplete();
  }
  stepWaterfall(dt);
  if(document.visibilityState==='visible') redrawAll();
  sim.rafId = requestAnimationFrame(animFrame);
}
function startLoop(){ if(!sim.rafId) sim.rafId = requestAnimationFrame(animFrame); }
function stopLoop(){ if(sim.rafId){ cancelAnimationFrame(sim.rafId); sim.rafId=null; } sim.lastFrameTime=0; }
document.addEventListener('visibilitychange', ()=>{
  if(document.visibilityState==='hidden') stopLoop(); else if(simBooted) startLoop();
});

/* ============================================================
   INIT
   ============================================================ */
function initSimulation(){
  if(simBooted){ redrawAll(); startLoop(); return; }
  simBooted = true;

  document.getElementById('emMinus').onclick = ()=>{ const el=document.getElementById('emCount'); el.textContent = Math.max(2, parseInt(el.textContent,10)-1); };
  document.getElementById('emPlus').onclick = ()=>{ const el=document.getElementById('emCount'); el.textContent = Math.min(5, parseInt(el.textContent,10)+1); };
  document.getElementById('btnGenerate').onclick = generateStream;
  document.getElementById('btnRun').onclick = runDeinterleave;
  document.getElementById('btnPause').onclick = pauseToggle;
  document.getElementById('btnReset').onclick = resetSimulation;
  document.getElementById('btnReplay').onclick = replayDemo;
  document.getElementById('btnJudge').onclick = toggleJudgeMode;
  document.getElementById('btnClearSel').onclick = clearSelection;
  document.getElementById('piClose').onclick = clearSelection;

  document.getElementById('scrubSlider').addEventListener('input', (e)=>{
    if(!sim.generated) return;
    sim.running = false;
    sim.progress = clamp(parseInt(e.target.value,10)/1000, 0, 1);
    redrawAll();
  });
  document.getElementById('featX').addEventListener('change', (e)=>{ sim.featX = e.target.value; redrawAll(); });
  document.getElementById('featY').addEventListener('change', (e)=>{ sim.featY = e.target.value; redrawAll(); });

  document.querySelectorAll('.viz-tab').forEach(btn=> btn.addEventListener('click', ()=> switchTab(btn.dataset.tab)));

  document.getElementById('emitterLegend').addEventListener('click', (e)=>{
    const item = e.target.closest('.legend-item'); if(!item) return;
    document.querySelectorAll('.legend-item').forEach(l=>l.classList.remove('selected'));
    item.classList.add('selected');
    showPdwForEmitter(parseInt(item.dataset.idx,10));
  });

  document.getElementById('wfLive').addEventListener('click', ()=>{ sim.waterfall.live=true; toggleWfButtons('live'); });
  document.getElementById('wfPause').addEventListener('click', ()=>{ sim.waterfall.live=false; toggleWfButtons('pause'); });
  document.getElementById('wfClear').addEventListener('click', ()=>{ sim.waterfall.rows=[]; });

  bindZoomButtons();
  bindWheelPan(document.getElementById('cvTime'), sim.view.time, false);
  bindWheelPan(document.getElementById('cvFeature'), sim.view.feature, true);

  attachCanvasInteraction(document.getElementById('cvTime'),'time');
  attachCanvasInteraction(document.getElementById('cvFeature'),'feature');
  attachCanvasInteraction(document.getElementById('cvFreq'),'freq');
  attachCanvasInteraction(document.getElementById('cvPri'),'pri');
  attachCanvasInteraction(document.getElementById('cvEmitters'),'emitters');
  attachCanvasInteraction(document.getElementById('cvOverview'),'overview');

  window.addEventListener('resize', ()=> redrawAll());

  generateStream();
  startLoop();
}
function toggleWfButtons(which){
  document.getElementById('wfLive').classList.toggle('on', which==='live');
  document.getElementById('wfPause').classList.toggle('on', which==='pause');
}

/* ============================================================
   BOOT
   ============================================================ */
renderRoute();
</script>
