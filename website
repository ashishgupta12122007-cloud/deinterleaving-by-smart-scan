const SVGNS = 'http://www.w3.org/2000/svg';
function svgEl(tag, attrs){
  const el = document.createElementNS(SVGNS, tag);
  for(const k in attrs) el.setAttribute(k, attrs[k]);
  return el;
}

/* ============================================================
   PULSE TRAIN RENDER (mini emitter timelines used across pages)
   pattern: array of x-positions 0..1
   ============================================================ */
function renderPulseTrack(container, pattern, color){
  const w = 600, h = 34;
  const svg = svgEl('svg', { viewBox: `0 0 ${w} ${h}`, width:'100%', height:'100%', preserveAspectRatio:'none' });
  svg.appendChild(svgEl('line', { x1:0, y1:h/2, x2:w, y2:h/2, stroke:'rgba(166,225,250,0.14)', 'stroke-width':1 }));
  pattern.forEach(p=>{
    const x = p*w;
    const line = svgEl('line', { x1:x, y1:6, x2:x, y2:h-6, stroke:color, 'stroke-width':2, opacity:0.9 });
    svg.appendChild(line);
    const dot = svgEl('circle', { cx:x, cy:h/2, r:2.6, fill:color });
    svg.appendChild(dot);
  });
  container.innerHTML = '';
  container.appendChild(svg);
}

function seededPattern(n, seed, jitter){
  // returns n increasing x positions in [0.03,0.97]
  let s = seed;
  const rnd = ()=>{ s = (s*9301+49297)%233280; return s/233280; };
  const arr = [];
  let x = 0.04 + rnd()*0.03;
  const step = 0.9/n;
  for(let i=0;i<n;i++){
    arr.push(Math.min(0.97, x));
    x += step*(1 + (rnd()-0.5)*jitter);
  }
  return arr;
}

function mergeSorted(tracks){
  const all = [];
  tracks.forEach((t,idx)=> t.forEach(x=> all.push({x, e:idx})));
  all.sort((a,b)=>a.x-b.x);
  return all;
}

