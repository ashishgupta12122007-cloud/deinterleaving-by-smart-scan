function switchTab(tab){
  sim.activeTab = tab;
  document.querySelectorAll('.viz-tab').forEach(b=>b.classList.toggle('active', b.dataset.tab===tab));
  document.querySelectorAll('.viz-panel').forEach(p=>p.classList.toggle('active', p.dataset.panel===tab));
