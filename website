}

/* ============================================================
   POINTER / HIT-TEST INTERACTION
   ============================================================ */
function ensureTooltip(container){
  let t = container.querySelector('.canvas-tooltip');
  if(!t){ t=document.createElement('div'); t.className='canvas-tooltip'; container.appendChild(t); }
  return t;
}
function attachCanvasInteraction(canvas, key){
  if(!canvas) return;
  const tooltip = ensureTooltip(canvas.parentElement);
  let downX=0, downY=0, moved=false;
  function findHit(evt){
    const rect = canvas.getBoundingClientRect();
    const x = evt.clientX-rect.left, y = evt.clientY-rect.top;
    const targets = sim.hitTargets[key]||[];
    let best=null, bestD=999;
    targets.forEach(tg=>{ const d=Math.hypot(tg.x-x,tg.y-y); if(d<tg.r+4 && d<bestD){ bestD=d; best=tg; } });
    return best;
  }
  canvas.addEventListener('mousedown', (evt)=>{ downX=evt.clientX; downY=evt.clientY; moved=false; });
  canvas.addEventListener('mousemove', (evt)=>{
    if(Math.hypot(evt.clientX-downX, evt.clientY-downY) > 4) moved = true;
    const hit = findHit(evt);
    sim.hoverId = hit ? hit.id : null;
    const rect = canvas.getBoundingClientRect();
    if(hit){
      const p = sim.pulses.find(pp=>pp.id===hit.id);
      if(p){
        tooltip.innerHTML = '<b>PULSE '+p.id+'</b><br>TOA '+p.toa.toFixed(2)+' μs<br>RF '+p.rf.toFixed(2)+' GHz<br>PRI '+p.pri.toFixed(2)+' μs<br>PW '+p.pw.toFixed(2)+' μs<br>AOA '+p.aoa.toFixed(1)+'°';
        tooltip.style.left = (evt.clientX-rect.left)+'px';
        tooltip.style.top = (evt.clientY-rect.top)+'px';
        tooltip.classList.add('show');
      }
    } else { tooltip.classList.remove('show'); }
    redrawView(key);
  });
  canvas.addEventListener('mouseleave', ()=>{ sim.hoverId=null; tooltip.classList.remove('show'); redrawView(key); });
  canvas.addEventListener('click', (evt)=>{
    if(moved) return;
    const hit = findHit(evt);
    if(hit) selectPulse(hit.id, evt); else clearSelection();
  });
}
function bindZoomButtons(){
  document.querySelectorAll('[data-zoom]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.dataset.zoom;
      if(key==='time-in') sim.view.time.scale = Math.min(6, sim.view.time.scale*1.35);
      if(key==='time-out') sim.view.time.scale = Math.max(1, sim.view.time.scale/1.35);
      if(key==='time-reset') sim.view.time = { scale:1, offset:0 };
      if(key==='feat-in') sim.view.feature.scale = Math.min(6, sim.view.feature.scale*1.35);
      if(key==='feat-out') sim.view.feature.scale = Math.max(1, sim.view.feature.scale/1.35);
      if(key==='feat-reset') sim.view.feature = { scale:1, offset:0, panX:0, panY:0 };
      redrawAll();
    });
  });
}
function bindWheelPan(canvas, view, isFeature){
  if(!canvas) return;
  canvas.addEventListener('wheel', (e)=>{
    e.preventDefault();
    const factor = e.deltaY<0 ? 1.1 : 0.9;
    view.scale = clamp(view.scale*factor, 1, 8);
    redrawAll();
  }, { passive:false });
  let dragging=false, lastX=0, lastY=0;
  canvas.addEventListener('mousedown', (e)=>{ dragging=true; lastX=e.clientX; lastY=e.clientY; });
  window.addEventListener('mousemove', (e)=>{
    if(!dragging) return;
    const dx=e.clientX-lastX, dy=e.clientY-lastY; lastX=e.clientX; lastY=e.clientY;
    if(isFeature){ view.panX+=dx; view.panY+=dy; } else { view.offset -= dx; }
    redrawAll();
  });
  window.addEventListener('mouseup', ()=>{ dragging=false; });
  canvas.addEventListener('dblclick', ()=>{ view.scale=1; view.offset=0; view.panX=0; view.panY=0; redrawAll(); });
}

